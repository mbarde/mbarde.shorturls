#. Default: "The URL short URLs start with, followed by their suffix (e.g. https://go.example.org)."
#: ../browser/controlpanel.py:25
msgid "base_url_description"
msgstr "Die URL, mit der Kurz-URLs beginnen, gefolgt von ihrem Suffix (z.B. https://go.example.org)."

#. Default: "Visitors of unknown short URLs (and of the base URL itself) get redirected to this URL, e.g. your main website. Leave empty to show a 'Not found' page instead."
#: ../browser/controlpanel.py:36
msgid "fallback_target_url_description"
msgstr "Besucher unbekannter Kurz-URLs (und der Basis-URL selbst) werden auf diese URL weitergeleitet, z.B. auf Ihre Hauptwebsite. Leer lassen, um stattdessen eine 'Nicht gefunden'-Seite anzuzeigen."

