msgid "Installs the mbarde.shorturls add-on."
msgstr "Installiert das Add-on mbarde.shorturls."

#: ../content/short_url.py:49
msgid "Only http:// and https:// URLs are allowed."
msgstr "Nur http://- und https://-URLs sind erlaubt."

#: ../content/short_url.py:37
msgid "Only letters (a-z, A-Z), digits, '-' and '_' are allowed."
msgstr "Nur Buchstaben (a-z, A-Z), Ziffern, '-' und '_' sind erlaubt."

#: ../browser/templates/short_url_container_view.pt:62
#: ../browser/templates/short_url_view.pt:35
#: ../profiles/default/types/ShortUrl.xml
msgid "Short URL"
msgstr "Kurz-URL"

#: ../profiles/default/types/ShortUrlContainer.xml
msgid "Short URL Folder"
msgstr "Kurz-URL-Ordner"

#: ../profiles/default/types/ShortUrl.xml
msgid "Short URL redirecting to a target URL"
msgstr "Kurz-URL, die auf eine Ziel-URL weiterleitet"

#: ../browser/templates/short_url_container_view.pt:61
#: ../content/short_url.py:111
msgid "Suffix"
msgstr "Suffix"

#: ../browser/templates/short_url_container_view.pt:63
#: ../browser/templates/short_url_view.pt:41
#: ../content/short_url.py:127
msgid "Target URL"
msgstr "Ziel-URL"

#: ../content/short_url.py:128
msgid "The URL the short URL redirects to."
msgstr "Die URL, auf die die Kurz-URL weiterleitet."

#: ../browser/controlpanel.py:13
msgid "The base URL must not end with a '/'."
msgstr "Die Basis-URL darf nicht mit einem '/' enden."

#: ../content/short_url.py:53
msgid "The domain of this URL is not allowed."
msgstr "Die Domain dieser URL ist nicht erlaubt."

#: ../content/short_url.py:41
msgid "The suffix of a short URL can't be changed."
msgstr "Das Suffix einer Kurz-URL kann nicht geändert werden."

#: ../browser/templates/short_url_container_view.pt:107
msgid "There are no short URLs here."
msgstr "Hier gibt es keine Kurz-URLs."

#: ../browser/templates/short_url_view.pt:22
msgid "This short URL is disabled: it doesn't redirect anymore, but its suffix stays reserved."
msgstr "Diese Kurz-URL ist deaktiviert: Sie leitet nicht mehr weiter, ihr Suffix bleibt aber reserviert."

#: ../content/short_url.py:45
msgid "This suffix is already in use."
msgstr "Dieses Suffix wird bereits verwendet."

#: ../configure.zcml:39
msgid "Uninstalls the mbarde.shorturls add-on."
msgstr "Deinstalliert das Add-on mbarde.shorturls."

#: ../profiles/default/types/ShortUrl.xml
#: ../profiles/default/types/ShortUrlContainer.xml
msgid "View"
msgstr "Anzeigen"

#: ../browser/templates/short_url_view.pt:56
msgid "Yes"
msgstr "Ja"

#. Default: "Target URLs of short URLs have to be on one of these domains (one per line) - including their subdomains, e.g. example.org also allows www.example.org. Leave empty to allow all domains. Only checked when short URLs are added or edited."
#: ../browser/controlpanel.py:74
msgid "allowed_domains_description"
msgstr "Ziel-URLs von Kurz-URLs müssen auf einer dieser Domains liegen (eine pro Zeile) - einschließlich ihrer Subdomains, z.B. erlaubt example.org auch www.example.org. Leer lassen, um alle Domains zu erlauben. Wird nur beim Hinzufügen oder Bearbeiten von Kurz-URLs geprüft."

#. Default: "The URL short URLs start with, followed by their suffix (e.g. https://go.example.org)."
#: ../browser/controlpanel.py:52
msgid "base_url_description"
msgstr "Die URL, mit der Kurz-URLs beginnen, gefolgt von ihrem Suffix (z.B. https://go.example.org)."

#. Default: "Visitors of unknown short URLs (and of the base URL itself) get redirected to this URL, e.g. your main website. Leave empty to show a 'Not found' page instead."
#: ../browser/controlpanel.py:63
msgid "fallback_target_url_description"
msgstr "Besucher unbekannter Kurz-URLs (und der Basis-URL selbst) werden auf diese URL weitergeleitet, z.B. auf Ihre Hauptwebsite. Leer lassen, um stattdessen eine 'Nicht gefunden'-Seite anzuzeigen."

#. Default: "${domain} is not a valid domain. Enter domains only, without protocol or path (e.g. example.org)."
#: ../browser/controlpanel.py:26
msgid "invalid_domain"
msgstr "${domain} ist keine gültige Domain. Nur Domains eingeben, ohne Protokoll oder Pfad (z.B. example.org)."

#: ../configure.zcml:30
msgid "mbarde.shorturls"
msgstr ""

#: ../configure.zcml:39
msgid "mbarde.shorturls (uninstall)"
msgstr ""

#: ../browser/controlpanel.py:91
msgid "mbarde.shorturls Settings"
msgstr "mbarde.shorturls Einstellungen"

#. Default: "The part of the short URL after the base URL. Matched case-insensitively, so it has to be unique regardless of case. It can't be changed later."
#: ../content/short_url.py:112
msgid "suffix_description"
msgstr "Der Teil der Kurz-URL nach der Basis-URL. Groß- und Kleinschreibung wird nicht unterschieden, daher muss das Suffix auch unabhängig davon eindeutig sein. Es kann später nicht mehr geändert werden."

#. Default: "The domain of this URL is not allowed. Allowed domains (including their subdomains): ${domains}"
#: ../content/short_url.py:56
msgid "target_url_domain_not_allowed"
msgstr "Die Domain dieser URL ist nicht erlaubt. Erlaubte Domains (einschließlich ihrer Subdomains): ${domains}"
