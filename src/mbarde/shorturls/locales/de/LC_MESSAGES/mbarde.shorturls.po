msgstr "Deaktiviert"

#: ../browser/templates/short_url_container_view.pt:43
msgid "Disabled short URLs don't redirect anymore, but keep their suffix reserved. Open one to enable it again."
msgstr "Deaktivierte Kurz-URLs leiten nicht mehr weiter, ihr Suffix bleibt aber reserviert. Öffnen Sie eine, um sie wieder zu aktivieren."

#: ../browser/templates/short_url_view.pt:62
#: ../profiles/default/types/ShortUrl.xml
#: ../profiles/default/types/ShortUrlContainer.xml
msgid "Edit"
msgstr "Bearbeiten"

#: ../browser/templates/short_url_view.pt:79
msgid "Enable"
msgstr "Aktivieren"

#: ../browser/controlpanel.py:23
msgid "Enter domains only, without protocol or path (e.g. example.org)."
msgstr "Nur Domains eingeben, ohne Protokoll oder Pfad (z.B. example.org)."

#: ../browser/controlpanel.py:62
msgid "Fallback target URL"
msgstr "Ausweich-Ziel-URL"

#: ../profiles/default/types/ShortUrlContainer.xml
msgid "Folder in which all logged-in users can create short URLs"
msgstr "Ordner, in dem alle angemeldeten Benutzer Kurz-URLs anlegen können"

#: ../content/short_url.py:135
msgid "How often the short URL has been used."
msgstr "Wie oft die Kurz-URL aufgerufen wurde."

