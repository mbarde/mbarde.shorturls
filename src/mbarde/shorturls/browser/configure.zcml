<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="mbarde.shorturls">

    <!-- Publish static files -->
    <plone:static
        name="mbarde.shorturls"
        type="plone"
        directory="static"
    />

    <browser:page
        name="view"
        for="mbarde.shorturls.content.short_url.IShortUrl"
        class=".short_url.ShortUrlView"
        template="templates/short_url_view.pt"
        permission="zope2.View"
    />

    <browser:page
        name="shorturls_listing"
        for="mbarde.shorturls.content.short_url_container.IShortUrlContainer"
        class=".short_url_container.ShortUrlContainerView"
        template="templates/short_url_container_view.pt"
        permission="zope2.View"
    />

    <!-- @@go/<suffix> redirects to the short url's target url -->
    <browser:page
        name="go"
        for="plone.base.interfaces.IPloneSiteRoot"
        class=".go.GoView"
        permission="zope2.Public"
    />

    <browser:page
        name="mbarde-shorturls-controlpanel"
        for="plone.base.interfaces.IPloneSiteRoot"
        class=".controlpanel.MbardeShorturlsControlPanelView"
        permission="cmf.ManagePortal"
    />

</configure>
