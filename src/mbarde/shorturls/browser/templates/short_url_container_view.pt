<html
  xmlns="http://www.w3.org/1999/xhtml"
  xml:lang="en"
  xmlns:tal="http://xml.zope.org/namespaces/tal"
  xmlns:metal="http://xml.zope.org/namespaces/metal"
  xmlns:i18n="http://xml.zope.org/namespaces/i18n"
  lang="en"
  metal:use-macro="context/@@main_template/macros/master"
  i18n:domain="mbarde.shorturls"
>
  <body>
    <metal:content-core fill-slot="content-core">
      <metal:block define-macro="content-core">
        <p tal:condition="view/canAdd">
          <a
            class="btn btn-primary"
            id="short-url-add"
            tal:attributes="href string:${context/absolute_url}/++add++ShortUrl"
            i18n:translate=""
          >Add short URL</a>
        </p>

        <ul class="nav nav-tabs mb-3" id="short-url-tabs">
          <li class="nav-item" tal:repeat="tab view/tabs">
            <a
              class="nav-link"
              tal:attributes="href tab/url;
                              id string:short-url-tab-${tab/state};
                              class python:'nav-link active' if tab['selected'] else 'nav-link'"
            >
              <tal:active tal:condition="python:tab['state'] == 'active'" i18n:translate=""
              >Active</tal:active>
              <tal:disabled tal:condition="python:tab['state'] == 'disabled'" i18n:translate=""
              >
                Disabled</tal:disabled>
              <span class="badge bg-secondary" tal:content="tab/count">0</span>
            </a>
          </li>
        </ul>

        <p
          class="discreet"
          id="short-urls-disabled-info"
          tal:condition="python:view.state == 'disabled'"
          i18n:translate=""
        >
          Disabled short URLs don't redirect anymore, but keep their suffix
          reserved. Open one to enable it again.
        </p>

        <tal:results tal:define="batch view/batch; baseUrl view/baseUrl">
          <tal:listing tal:condition="batch">
            <div metal:use-macro="context/batch_macros/macros/navigation"></div>

            <div class="table-responsive">
              <table class="table table-striped" id="short-urls">
                <thead>
                  <tr>
                    <th i18n:translate="">Suffix</th>
                    <th tal:condition="baseUrl" i18n:translate="">Short URL</th>
                    <th i18n:translate="">Target URL</th>
                    <th class="text-end" i18n:translate="">Clicks</th>
                    <th i18n:translate="">Last clicked</th>
                    <th i18n:translate="">Created by</th>
                    <th i18n:translate="">Created</th>
                  </tr>
                </thead>
                <tbody>
                  <tal:entries tal:repeat="item batch">
                    <tr tal:define="obj item/getObject">
                      <td>
                        <a
                          class="short-url-item"
                          tal:attributes="href item/getURL"
                          tal:content="obj/suffix"
                        />
                      </td>
                      <td tal:condition="baseUrl">
                        <a
                          tal:define="shortUrl string:${baseUrl}/${obj/suffix}"
                          tal:attributes="href shortUrl"
                          tal:content="shortUrl"
                          target="_blank"
                        />
                      </td>
                      <td class="text-break">
                        <a
                          tal:attributes="href obj/target_url"
                          tal:content="obj/target_url"
                          target="_blank"
                        />
                      </td>
                      <td class="text-end" tal:content="obj/clicks" />
                      <td
                        class="text-nowrap last-clicked"
                        tal:content="python:view.localizedDate(obj.last_clicked)"
                      />
                      <td tal:content="item/Creator" />
                      <td
                        class="text-nowrap"
                        tal:content="python:view.toLocalizedTime(item.CreationDate())"
                      />
                    </tr>
                  </tal:entries>
                </tbody>
              </table>
            </div>

            <div metal:use-macro="context/batch_macros/macros/navigation"></div>
          </tal:listing>

          <p
            class="discreet"
            id="short-urls-empty"
            tal:condition="not:batch"
            i18n:translate=""
          >
            There are no short URLs here.
          </p>
        </tal:results>
      </metal:block>
    </metal:content-core>
  </body>
</html>