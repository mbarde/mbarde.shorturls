<html
  xmlns="http://www.w3.org/1999/xhtml"
  xml:lang="en"
  xmlns:tal="http://xml.zope.org/namespaces/tal"
  xmlns:metal="http://xml.zope.org/namespaces/metal"
  xmlns:i18n="http://xml.zope.org/namespaces/i18n"
  lang="en"
  metal:use-macro="context/main_template/macros/master"
  i18n:domain="mbarde.shorturls"
>
  <body>
    <metal:main fill-slot="main">
      <tal:main-macro metal:define-macro="main">
        <div tal:replace="structure provider:plone.abovecontenttitle" />

        <h1 class="documentFirstHeading" tal:content="context/suffix" />

        <div tal:replace="structure provider:plone.belowcontenttitle" />

        <div tal:replace="structure provider:plone.abovecontentbody" />

        <div
          class="alert alert-warning"
          id="short-url-disabled"
          tal:condition="view/isDisabled"
          i18n:translate=""
        >
          This short URL is disabled: it doesn't redirect anymore, but its
          suffix stays reserved.
        </div>

        <table class="listing table table-striped" id="short-url-details">
          <tbody>
            <tr tal:define="shortUrl view/shortUrl" tal:condition="shortUrl">
              <td i18n:translate="">Short URL</td>
              <td>
                <a id="short-url" tal:attributes="href shortUrl" tal:content="shortUrl" />
              </td>
            </tr>
            <tr>
              <td i18n:translate="">Target URL</td>
              <td>
                <a
                  id="target-url"
                  tal:attributes="href context/target_url"
                  tal:content="context/target_url"
                />
              </td>
            </tr>
            <tr>
              <td i18n:translate="">Clicks</td>
              <td id="clicks" tal:content="context/clicks" />
            </tr>
            <tr tal:condition="context/is_api">
              <td i18n:translate="">Created via API</td>
              <td i18n:translate="">Yes</td>
            </tr>
          </tbody>
        </table>

        <div class="d-flex gap-2" id="short-url-actions">
          <a
            class="btn btn-primary"
            id="short-url-edit"
            tal:condition="view/canEdit"
            tal:attributes="href string:${context/absolute_url}/edit"
            i18n:translate=""
            >Edit</a
          >
          <a
            class="btn btn-danger"
            id="short-url-disable"
            tal:define="url python:view.transitionUrl('disable')"
            tal:condition="url"
            tal:attributes="href url"
            i18n:translate=""
            >Disable</a
          >
          <a
            class="btn btn-success"
            id="short-url-enable"
            tal:define="url python:view.transitionUrl('enable')"
            tal:condition="url"
            tal:attributes="href url"
            i18n:translate=""
            >Enable</a
          >
          <a
            class="btn btn-outline-danger"
            id="short-url-delete"
            tal:condition="view/canDelete"
            tal:attributes="href string:${context/absolute_url}/delete_confirmation"
            i18n:translate=""
            >Delete permanently</a
          >
        </div>

        <div tal:replace="structure provider:plone.belowcontentbody" />
      </tal:main-macro>
    </metal:main>
  </body>
</html>
