<configure
  xmlns="http://namespaces.zope.org/zope"
  xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
  xmlns:i18n="http://namespaces.zope.org/i18n"
  xmlns:plone="http://namespaces.plone.org/plone"
  i18n_domain="mbarde.shorturls">

  <i18n:registerTranslations directory="locales" />

  <!--
    Be careful if you use general includeDependencies, it can have sideffects!
    Better import explicite packages or configurations ;)
  -->
  <!--<includeDependencies
  package="." />-->

  <include file="permissions.zcml" />

  <include package=".browser" />

  <include file="upgrades.zcml" />

  <genericsetup:registerProfile
    name="default"
    title="mbarde.shorturls"
    directory="profiles/default"
    description="Installs the mbarde.shorturls add-on."
    provides="Products.GenericSetup.interfaces.EXTENSION"
    post_handler=".setuphandlers.post_install"
  />

  <genericsetup:registerProfile
    name="uninstall"
    title="mbarde.shorturls (uninstall)"
    directory="profiles/uninstall"
    description="Uninstalls the mbarde.shorturls add-on."
    provides="Products.GenericSetup.interfaces.EXTENSION"
    post_handler=".setuphandlers.uninstall"
  />

  <utility
    factory=".setuphandlers.HiddenProfiles"
    name="mbarde.shorturls-hiddenprofiles"
  />

  <!-- id derived from the suffix, generating a missing one -->
  <adapter factory=".content.short_url.NameFromSuffix" />

  <!-- lowercased suffix for case-insensitive lookups -->
  <adapter
    factory=".content.short_url.suffixIndexer"
    name="shorturl_suffix"
  />

  <!-- target url, to find existing short urls for it -->
  <adapter
    factory=".content.short_url.targetUrlIndexer"
    name="shorturl_target_url"
  />

  <!-- suffix has to be unique: add/edit forms and plone.restapi -->
  <adapter factory=".content.short_url.SuffixValidator" />
  <adapter factory=".content.short_url.SuffixDeserializer" />

  <!-- a copy would duplicate the suffix (moving is fine) -->
  <subscriber
    for=".content.short_url.IShortUrl
         zope.lifecycleevent.interfaces.IObjectCopiedEvent"
    handler=".content.short_url.refuseCopy"
  />

  <!-- generate a missing suffix of short urls added with an explicit id -->
  <subscriber
    for=".content.short_url.IShortUrl
         zope.lifecycleevent.interfaces.IObjectAddedEvent"
    handler=".content.short_url.generateMissingSuffix"
  />

  <!-- remember whether a short url was created via plone.restapi -->
  <subscriber
    for=".content.short_url.IShortUrl
         zope.lifecycleevent.interfaces.IObjectAddedEvent"
    handler=".content.short_url.markCreatedViaApi"
  />

</configure>