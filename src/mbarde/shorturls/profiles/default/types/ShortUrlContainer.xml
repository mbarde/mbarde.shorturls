<?xml version="1.0"?>
<object xmlns:i18n="http://xml.zope.org/namespaces/i18n"
  name="ShortUrlContainer"
  meta_type="Dexterity FTI"
  i18n:domain="mbarde.shorturls">

  <!-- Basic properties -->
  <property
    i18n:translate=""
    name="title">Short URL Folder</property>
  <property
    i18n:translate=""
    name="description">Folder in which all logged-in users can create short URLs</property>

  <property name="allow_discussion">False</property>
  <property name="factory">ShortUrlContainer</property>
  <property name="icon_expr">string:folder-symlink</property>
  <property name="link_target"></property>

  <!-- Hierarchy control -->
  <property name="global_allow">True</property>
  <property name="filter_content_types">True</property>
  <property name="allowed_content_types">
    <element value="ShortUrl" />
  </property>
  <!-- Schema, class and security -->
  <property name="add_permission">mbarde.shorturls.AddShortUrlContainer</property>
  <property name="klass">mbarde.shorturls.content.short_url_container.ShortUrlContainer</property>
  <property name="model_file"></property>
  <property name="model_source"></property>
  <property name="schema">mbarde.shorturls.content.short_url_container.IShortUrlContainer</property>

  <!-- Enabled behaviors -->
  <property name="behaviors" purge="false">
    <element value="plone.basic" />
    <element value="plone.namefromtitle" />
    <element value="plone.shortname" />
    <element value="plone.excludefromnavigation" />
  </property>

  <!-- View information -->
  <property name="add_view_expr">string:${folder_url}/++add++ShortUrlContainer</property>
  <property name="default_view">shorturls_listing</property>
  <property name="default_view_fallback">False</property>
  <property name="immediate_view">shorturls_listing</property>
  <property name="view_methods">
    <element value="shorturls_listing" />
  </property>

  <!-- Method aliases -->
  <alias
    from="(Default)"
    to="(dynamic view)"
  />
  <alias
    from="edit"
    to="@@edit"
  />
  <alias
    from="sharing"
    to="@@sharing"
  />
  <alias
    from="view"
    to="(selected layout)"
  />

  <!-- Actions -->
  <action
    action_id="view"
    category="object"
    condition_expr=""
    i18n:attributes="title"
    title="View"
    url_expr="string:${object_url}"
    visible="True">
    <permission value="View" />
  </action>
  <action
    action_id="edit"
    category="object"
    condition_expr=""
    i18n:attributes="title"
    title="Edit"
    url_expr="string:${object_url}/edit"
    visible="True">
    <permission value="Modify portal content" />
  </action>

</object>
